# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# CIS benchmark sources and working notes (draft/confidential — do not commit).
# No trailing slash: with one, the pattern matches a directory only, and a symlink of
# the same name is still tracked. One was committed that way, and checking it out
# replaced the real directory.
/benchmark

# Benchmark spreadsheets, wherever they land. Draft revisions arrive as .xlsx in
# the repository root, which /benchmark/ does not cover.
*.xlsx

# Local worktrees for feature branches
.worktrees/

# Browser automation scratch output: page snapshots can capture draft content
.playwright-mcp/
